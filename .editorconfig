# Describes the tree as it already is — it is not a proposal, and it is not a sweep.
# There is no Prettier and no Spotless here; do not reformat files you did not
# otherwise change. See AGENTS.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kts}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
